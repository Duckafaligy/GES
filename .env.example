# ── GES Client Portal — server-side env (never exposed to the browser) ──
# Copy this file to `.env.local` and fill in the values.

# Supabase project (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret used to sign short-lived access tokens (client previews + dashboard).
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Developer dashboard login at /Developer-Dashboard-Page — BOTH are required.
DEV_DASHBOARD_PASSWORD=
# Your date of birth as YYYY-MM-DD (second login factor).
DEV_DASHBOARD_DOB=

# ── Google Calendar (optional) — auto-creates an event on your calendar when
#    someone books a call, so you're notified. Uses a service account:
#    1) GCP → enable Google Calendar API → create a service account + JSON key
#    2) Share your Google Calendar with the service account email ("Make changes to events")
#    3) Fill these in (locally + Vercel). Leave blank to disable.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
