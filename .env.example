# GES — server-side env (never exposed to the browser).
# Copy this file to `.env.local` and fill in the values.

# Supabase project (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret used to sign short-lived access tokens (client previews + dashboard).
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Developer dashboard login at /Developer-Dashboard-Page — BOTH are required.
DEV_DASHBOARD_PASSWORD=
# Your date of birth as YYYY-MM-DD (second login factor).
DEV_DASHBOARD_DOB=

# Vercel — powers "Deploy Project to Vercel" in the dashboard.
# Token: https://vercel.com/account/tokens ; VERCEL_TEAM_ID only if under a team.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Stripe (test mode) — marketplace checkout + secure delivery.
# Secret key: dashboard.stripe.com/test/apikeys ; webhook secret: from `stripe listen`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Booking notification email (Resend) — pings you when someone books.
RESEND_API_KEY=
BOOKING_NOTIFY_EMAIL=
BOOKING_FROM_EMAIL=

# Google Calendar (optional) — auto-creates a calendar event on booking (service account).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
