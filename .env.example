# ── GES Client Portal — server-side env (never exposed to the browser) ──
# Copy this file to `.env.local` and fill in the values.

# Supabase project (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret used to sign short-lived access tokens (client previews + dashboard).
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Password for the developer dashboard at /Developer-Dashboard-Page
DEV_DASHBOARD_PASSWORD=

# Vercel — powers "Deploy Project to Vercel" in the dashboard.
# Create a token at https://vercel.com/account/tokens. VERCEL_TEAM_ID only if the
# project should live under a team (Account/Team Settings → General → Team ID).
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Stripe (test mode is fine to start) — checkout + secure delivery.
# Secret key: dashboard.stripe.com/test/apikeys ; webhook secret: from `stripe listen`
# or the webhook endpoint you create pointing at /api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
