# ── GES Client Portal — server-side env (never exposed to the browser) ──
# Copy this file to `.env.local` and fill in the values.

# Supabase project (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret used to sign short-lived access tokens (client previews + dashboard).
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Developer dashboard login at /Developer-Dashboard-Page — BOTH are required.
DEV_DASHBOARD_PASSWORD=
# Your date of birth as YYYY-MM-DD (second login factor).
DEV_DASHBOARD_DOB=
